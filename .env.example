ICAB_DATABASE_URL=postgresql://icab:icab@localhost:5432/icab
ICAB_NEO4J_URI=bolt://localhost:7687
ICAB_NEO4J_USERNAME=neo4j
ICAB_NEO4J_PASSWORD=icabpassword

# Optional -- defaults shown below (docker-compose's mqtt_broker service).
ICAB_MQTT_HOST=localhost
ICAB_MQTT_PORT=1883

# LLM agent (M6) -- provider-agnostic; never commit a real key here.
# NIST RChat is an OpenAI-compatible (vLLM-backed) endpoint.
ICAB_LLM_PROVIDER=nist-rchat
ICAB_LLM_API_KEY=
ICAB_LLM_BASE_URL=https://rchat.nist.gov/api/v1
ICAB_LLM_MODEL=gemma-4-31B-it