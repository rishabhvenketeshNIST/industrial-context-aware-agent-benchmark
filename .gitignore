# Generated benchmark/experiment artifacts -- results/'s directory
# skeleton is tracked (via .gitkeep in each subdirectory), but the
# generated content inside is NOT: a fresh benchmark invocation
# (scripts/run_benchmark.py / run_experiment.py / generate_report.py /
# run_context_aware_agent.py / run_agent.py) must never accidentally
# commit development/debugging/smoke-test output as if it were
# production research data. See docs/benchmark/specification.md for
# the full results/ layout and README.md's "Research Data Collection"
# section for the intended workflow.
results/raw/*
results/traces/*
results/evaluations/*
results/aggregate/*
results/reports/*
results/figures/*
results/hypotheses/*
results/prototype/*
!results/raw/.gitkeep
!results/traces/.gitkeep
!results/evaluations/.gitkeep
!results/aggregate/.gitkeep
!results/reports/.gitkeep
!results/figures/.gitkeep
!results/hypotheses/.gitkeep
!results/prototype/.gitkeep

# ICAB v3: six ISA-95-level benchmarks (icab.benchmark.levels), each
# with its own results/<level>/ tree -- same "skeleton tracked, content
# generated/gitignored" policy as above, plus the new matrices/
# summaries/manifest.json this milestone adds. results/_archive/ (old,
# pre-v3 results archived by scripts/reset_active_results.py) is
# entirely local, never committed -- see docs/benchmark/specification-v3.md.
#
# NOTE: `!dir/**/.gitkeep` alone does NOT work here -- once git treats a
# subdirectory itself as ignored (matched by the `dir/**` rule above
# it), it never descends into that subdirectory to apply a deeper
# negation, so a nested .gitkeep stays hidden. The fix is the classic
# three-step idiom below: ignore direct children, un-ignore the
# subdirectories themselves so git still traverses into them, THEN
# ignore/un-ignore one level deeper -- verified with
# `git check-ignore -v` against every level's raw/.gitkeep before
# committing.
results/enterprise/*
results/site/*
results/area/*
results/work_center/*
results/process_cell/*
results/equipment/*
!results/enterprise/*/
!results/site/*/
!results/area/*/
!results/work_center/*/
!results/process_cell/*/
!results/equipment/*/
results/enterprise/*/*
results/site/*/*
results/area/*/*
results/work_center/*/*
results/process_cell/*/*
results/equipment/*/*
!results/enterprise/*/.gitkeep
!results/site/*/.gitkeep
!results/area/*/.gitkeep
!results/work_center/*/.gitkeep
!results/process_cell/*/.gitkeep
!results/equipment/*/.gitkeep
results/_archive/
